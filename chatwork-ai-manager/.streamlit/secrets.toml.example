# このファイルを secrets.toml にコピーして値を埋めてください（secrets.toml は .gitignore 済み）。

# Chatwork API トークン（必須）
# 開発中は shinsei99 個人アカウントのトークンでOK（テストはマイチャットで）。
# AI専用アカウント運用に切り替える時は、そのアカウントで発行したトークンに差し替えるだけ。
# 取得: Chatwork 右上「設定」→「API Token」（組織がAPI利用許可済みであること）。
chatwork_api_token = "あなたのChatwork APIトークン"

# 管理画面ログインパスワード（必須・任意の文字列）。
dashboard_password = "変更してください"

# Webhook を使う場合のみ（M1 はポーリングのため未使用）。
# chatwork_webhook_token = ""

# 社内ナレッジの取込元フォルダ（任意）。未設定なら管理画面で都度指定。
# 例（Dropbox 共有フォルダ・full-width スペースに注意）:
# knowledge_source_dir = "/Users/apple/Library/CloudStorage/Dropbox-大京商事　株式会社/共有フォルダ/（★必読★）新共有フォルダ"
