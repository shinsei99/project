# このファイルを secrets.toml にコピーして値を埋めてください（secrets.toml は .gitignore 済み）。

# Chatwork API トークン（必須）
# 開発中は shinsei99 個人アカウントのトークンでOK（テストはマイチャットで）。
# AI専用アカウント運用に切り替える時は、そのアカウントで発行したトークンに差し替えるだけ。
# 取得: Chatwork 右上「設定」→「API Token」（組織がAPI利用許可済みであること）。
chatwork_api_token = "あなたのChatwork APIトークン"

# 管理画面ログインパスワード（必須・任意の文字列）。
dashboard_password = "変更してください"

# Webhook を使う場合のみ（M1 はポーリングのため未使用）。
# chatwork_webhook_token = ""

# 社内ナレッジの取込元フォルダ（任意）。未設定なら管理画面で都度指定。
# 例（Dropbox 共有フォルダ・full-width スペースに注意）:
# knowledge_source_dir = "/Users/apple/Library/CloudStorage/Dropbox-大京商事　株式会社/共有フォルダ/（★必読★）新共有フォルダ"

# Chatwork音声添付（ボイスメモ等）の文字起こし用（任意・TASK-20260826-004）。
# claude CLI は音声入力に非対応のため Gemini API を使う。新規発行はしていない。
# brain-dump/madori-tracer/pasha-calo/agent-platform と同じ全社共有キーを流用する。
# 未設定でも動く（音声添付は「文字起こしに失敗」の注記のみになり、他の機能は影響なし）。
# gemini_api_key = ""
# gemini_model = "gemini-2.5-flash"

# streetview_lookup Tool 用（任意・TASK-20260819-004）。
# Google Cloud で Street View Static API を有効化して発行したAPIキー（要課金設定・新規発行は人の判断）。
# 未設定でも動く（代わりにGoogleマップの衛星写真＝無料・キー不要でPOIラベルを読む）。
# google_maps_api_key = ""

# 業務日報を社内メールへ送るためのSMTP（2026-08-21 追加）
# ★サーバー設定は 2026-08-21 に実測して確定した:
#   smtp.daikyocorp.co.jp（122.28.46.202・Postfix。MXは OCN の mwbgw1/2.ocn.ad.jp）
#   **587 のみ開いている**（465 と 25 は閉じている）／STARTTLS あり／AUTH PLAIN LOGIN
#   添付を含む上限は 30MB（EHLO の SIZE 31457280）
smtp_host = "smtp.daikyocorp.co.jp"
smtp_port = "587"
smtp_user = "shin@daikyocorp.co.jp"
# パスワードは次のどちらか。平文を置きたくなければキーチェーンを使う:
#   security add-generic-password -s chatwork-ai-manager-smtp -a shin@daikyocorp.co.jp -w
smtp_password = ""
smtp_password_keychain = "chatwork-ai-manager-smtp"
smtp_from = "shin@daikyocorp.co.jp"
