# 写して .env.mail-archiver にする（このファイルは git に入らない）
MAIL_ACCOUNT=shin
IMAP_HOST=imap.example.co.jp
IMAP_PORT=993
IMAP_USER=you@example.co.jp
# 平文を置きたくなければ空にして IMAP_PASSWORD_KEYCHAIN にサービス名を書く
IMAP_PASSWORD=
IMAP_PASSWORD_KEYCHAIN=
IMAP_SSL=1

# ★サーバー側の削除。既定は無効（0）。有効にしても実行時に --delete --yes が要る
ARCHIVE_DELETE_ENABLED=0
ARCHIVE_DELETE_DAYS=14
# 取り込みも削除もしないフォルダ（ゴミ箱・迷惑メールは対象外にしておく）
ARCHIVE_EXCLUDE_FOLDERS=Trash,Deleted Messages,Junk,ゴミ箱,迷惑メール
