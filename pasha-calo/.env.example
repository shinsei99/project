# コピーして .env.local を作成してください

# ログイン用の合言葉（必須。未設定だと全リクエストを拒否します）
ACCESS_CODE=change-me

# 使用するAI: gemini（既定）or claude
AI_PROVIDER=gemini

# --- AI_PROVIDER=gemini のとき ---
# 取得: https://aistudio.google.com/apikey （無料枠あり）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- AI_PROVIDER=claude のとき ---
# 取得: https://console.anthropic.com/settings/keys （従量課金・要クレジット）
# ※ 見積書アプリ等で使っている `claude` コマンドはMac専用でサーバー上では動かないため、
#    スマホから使う構成ではこちらのAPIキーが必要になります。
ANTHROPIC_API_KEY=your-anthropic-api-key
# 迷ったら claude-opus-5。安く速くしたいなら claude-sonnet-5 / claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
