<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.shinsei.zenn-daily</string>
	<key>ProgramArguments</key>
	<array><string>/bin/bash</string><string>-lc</string><string>/Users/apple/ai-tools-base/scripts/zenn-daily.sh</string></array>
	<key>WorkingDirectory</key><string>/Users/apple/ai-tools-base</string>
	<key>RunAtLoad</key><false/>
	<key>StartCalendarInterval</key><dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
	<key>StandardOutPath</key><string>/tmp/zenn-daily.log</string>
	<key>StandardErrorPath</key><string>/tmp/zenn-daily.log</string>
</dict>
</plist>
