<?xml version="1.0" encoding="UTF-8"?>
<!-- 毎日1本、新しいネタから記事を書いて予約・本番反映まで入れる（メインPCのみ）。
     毎日 23:30。ログは ~/Library/Logs/com.shinsei.daily-write.log

     2026-08-27 に週次から日次へ変更。Zenn も note も「毎日1本」出す設定なので、
     書くのが週1本だと予約が尽きて出せなくなる。書く速さと出す速さを揃える。

     ★同じ日のうちに 8:07 → 22:45 へ移した。夜へ寄せる理由は3つ:
       1. **Macが起きていないといけない窓が1つで済む**（朝と夜の2回だったのが夜だけ）
       2. Zenn公開 → note投稿 の**直後**なので、その晩のURLを links へ入れて
          そのまま本番反映できる（朝だと約10時間ずれていた）
       3. 朝へ寄せることはできない。note は Zenn の後に出す必要があり、
          その両方が終わってからでないと links が埋まらないため

     ★順番は 22:00 Zenn → 23:00 note → 23:30 執筆（2026-09-05 に 22:45 から変更）。
       note を 22:35 → 23:00 へ下げたのに合わせて、**この工程は必ず note の後ろに置く**。
       ここは「新しい1本を書く」だけでなく、**その晩に出た Zenn / note のURLを
       制作記録の links へ入れて本体サイトを本番デプロイする**役目も持っている。
       前へ動かすと3媒体そろうのが毎日1日遅れる（validate の転載⚠️が残り続ける）。

     入れ方: cp して launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.shinsei.daily-write.plist
     外し方: launchctl bootout gui/$(id -u)/com.shinsei.daily-write
     ★先に drafts/.pii-blocklist.txt を埋めておくこと（社名・物件名・人名）。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.shinsei.daily-write</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/apple/ai-tools-base/scripts/daily-write.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <!-- ★ログは /tmp に置かない。macOS が再起動時に /private/tmp を掃除するので、
       夜に動いた証拠が朝には消えている（2026-08-28の再起動で実際に消えた）。 -->
  <key>StandardOutPath</key><string>/Users/apple/Library/Logs/com.shinsei.daily-write.log</string>
  <key>StandardErrorPath</key><string>/Users/apple/Library/Logs/com.shinsei.daily-write.err.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
