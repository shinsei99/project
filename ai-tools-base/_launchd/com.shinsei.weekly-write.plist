<?xml version="1.0" encoding="UTF-8"?>
<!-- 週に一度、新しいネタから記事を1本書いて予約まで入れる（メインPCのみ）。
     日曜 8:07（:00 や :30 を避ける）。ログは /tmp/weekly-write.log

     入れ方: cp して launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.shinsei.weekly-write.plist
     ★先に drafts/.pii-blocklist.txt を埋めておくこと（社名・物件名・人名）。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.shinsei.weekly-write</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/apple/ai-tools-base/scripts/weekly-write.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>7</integer>
  </dict>
  <key>StandardOutPath</key><string>/tmp/weekly-write.log</string>
  <key>StandardErrorPath</key><string>/tmp/weekly-write.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
