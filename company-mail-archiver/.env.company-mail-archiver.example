# 社内メールアーカイバの設定（見本）。
#
# **1アカウント＝1ファイル**にする。
#   .env.company-mail-archiver.<社員のslug>   … 社員ごと（例: .env.company-mail-archiver.tanaka）
#   .env.company-mail-archiver                … 共通（画面のパスワード・保管先など）
#
# ★このファイルの実体は git に入らない（`.env.company-mail-archiver*` は除外）。
#   見本（.example）だけが追跡される。

MAIL_ACCOUNT=tanaka                       # 呼び名（英数字。DBのアカウント名になる）
IMAP_HOST=mail.daikyocorp.co.jp
IMAP_PORT=993
IMAP_USER=tanaka@daikyocorp.co.jp
# パスワードは平文で書かず、キーチェーンから読む（ターミナル.appから1回だけ登録する）
#   security add-generic-password -s company-mail-archiver -a tanaka@daikyocorp.co.jp -w
IMAP_PASSWORD=
IMAP_PASSWORD_KEYCHAIN=company-mail-archiver
# ssl / starttls / none。空なら 993→SSL・143→STARTTLS と自動判定する
# ★Apple Mail の「ポート143＋SSLを使う」は STARTTLS のこと（143にSSLで繋ぐと必ず落ちる）
IMAP_SECURITY=

# ★★ 社員のメールは絶対にサーバーから消さない。ここは 0 のまま変えないこと。
#   1 にすると sync-daily.sh が取り込み自体を中止する（安全弁）。
ARCHIVE_DELETE_ENABLED=0

# 取り込まないフォルダ。迷惑メール・ゴミ箱は入れない
ARCHIVE_EXCLUDE_FOLDERS=Trash,Deleted Messages,Junk,ゴミ箱,迷惑メール,下書き,Drafts

# 画面の名前（個人用の 8535 と取り違えないように変える）
UI_TITLE=社内メールアーカイバ

# 画面のパスワード。**127.0.0.1 でしか動かさない方針だが、必ず設定する**
UI_PASSWORD=

# 原本(.eml)・添付の置き場。**会社の共有Dropboxには置かない**（社員全員に見えてしまう）
ARCHIVE_STORE_DIR=
