# Ignore everything in home directory by default
*

# Explicitly track these paths
!.gitignore
!CLAUDE.md
!TODO.md
!SESSION_LOG.md
!HANDOFF.md
!ios-build-guard.sh
# iOSシミュレータを操作する道具（タップ・なぞる・日本語入力・画面の位置合わせ）。
# xcrun simctl にタップが無いので、画面を見て確かめるにはこれが要る
!simtap.py
# 共通Visual Agent（Claude Codeがブラウザを見て操作する仕組み）。
# .mcp.json が定義の実体、VISUAL_AGENT.md が使い方。**秘密情報は含まない**ので他PCへも配る
!.mcp.json
!VISUAL_AGENT.md
!visual-agent-check.sh
# PCまたぎの整備ツール（2026-08-16にサブPCで作ったが、この許可行が無く
# コミットされていなかった。commitメッセージには載っているのに実体が来ない）
!SETUP.md
# Google Maps Platform の導入前調査（料金・規約の裏取り）。6アプリにまたがるので直下に置く
!GOOGLE_MAPS_API.md
# APIの棚卸しと段取り（どのAPIを持っていて、次に何を取るか）。明日の再開点
!API_STATUS.md
!dev-doctor.py
!dev-setup.sh
!secrets-sync.sh
!secrets-manifest.txt
# 開発環境のバージョン基準（2台で揃えるため。pyenv/nvm が無くても dev-doctor が照合する）
!.python-version
!.nvmrc
# Claude Code の「目」（Visual Agent）。撮った画像とプロファイルは .see/ で無視される
!see.sh
!see.py
# 日本郵便「郵便番号・デジタルアドレスAPI」の共通クライアント（住所の正規化。複数アプリから使う）
# 資格情報は .env.japanpost 側（gitignoreのまま・secrets-manifest.txt で運ぶ）
!japanpost_api.py

# Google Maps の共通クライアント（住所→緯度経度・ストリートビュー。複数アプリから使う）
# キーは .env.google-maps 側（gitignoreのまま・secrets-manifest.txt で運ぶ）
!google_maps_api.py
!registry_parser.py
# 自社（宅建業者・宅建士）情報。**コードだけ** git に入れる。
# 実データ config/company_profile.json は個人情報なので入れない（許可行を作らない）
!company_profile.py
!tokuyaku_clauses.py
!tokuyaku_core.py
!tokuyaku_cases.py
!tokuyaku_cases.json
!jyuusetsu_checklist.py
!jyuusetsu_checklist.json

# e-Gov 法令API の共通クライアント（法令の最新条文。キー不要・無料）
# 取得した全文のキャッシュ .egov-cache/ は入れない（1行目の * で既に除外）
!egov_law_api.py

# App Store Connect API の共通クライアント（登録済みビルド番号の照会）
# 資格情報は .env.appstore と .appstore/AuthKey_*.p8 側（gitignoreのまま）
!appstore_api.py

# e-Stat（政府統計）の共通クライアント（人口・世帯・空き家・借家の商圏データ）
# appId は .env.estat 側（gitignoreのまま・secrets-manifest.txt で運ぶ）
# 表のメタ情報のキャッシュ .estat-cache/ は入れない（1行目の * で既に除外）
!estat_api.py

# 商圏データのまとめ方（査定8509・事業計画8533が同じこれを読む。estat_api.py の上の層）
!area_stats.py

# 生成文の法令引用が実在するかを e-Gov で確かめる層（特約8513などが読む）
!law_citations.py

# requests が無い環境（launchd の /usr/bin/python3）でも動かすためのHTTP互換層
# 直下のAPIクライアント4本がこれを読む
!http_compat.py

# PDFの向き補正。2026-08-23 に8アプリのコピーを1本化（各アプリ側は委譲だけ）
!pdf_orient.py
!va.sh
!visual_agent.py
# アプリを都度起動する道具（起動→ポート待ち→HTTP確認を1コマンドに畳む）。
# Claude Code の確認プロンプトを減らす目的も兼ねる（nohup・待ちループを1本に閉じ込める）
!app-start.sh
