# ============================================================
# agent-platform — 接続情報テンプレート
# 使い方: cp .env.example .env   して、使うものだけ値を入れる。
#   .env は .gitignore 済み（このリポジトリは public なので絶対にコミットしない）
#   設定確認は: python main_orchestrator.py --doctor
#   キーを入れなかった部隊は「縮退モード」で動く（ダミー成果物を作って先へ進む）
# ============================================================

# ------------------------------------------------------------
# 1. APIキー（使うものだけ入れる）
# ------------------------------------------------------------

# Claude / Anthropic … 司令塔・企画構成・法務監査
#   ※未設定でも、ローカルの `claude` CLI があればそちらを自動で使う（キー不要）
ANTHROPIC_API_KEY=

# OpenAI … 企画補助(GPT-4o) / 画像生成(DALL-E 3) / 音声合成(TTS)
OPENAI_API_KEY=

# Google Gemini … リサーチャー（長文コンテキスト）
#   GEMINI_API_KEY / GOOGLE_API_KEY のどちらでも読む
GEMINI_API_KEY=

# Groq … 高速チェッカー（Llama系・超高速推論）
GROQ_API_KEY=

# ElevenLabs … 高品質ナレーション（未設定なら OpenAI TTS → gTTS の順に落ちる）
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Stability AI … 画像生成の代替（DALL-E 3 を使わない場合）
STABILITY_API_KEY=

# ------------------------------------------------------------
# 2. 使用モデル（変えたいときだけ書き換える）
# ------------------------------------------------------------
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------------------
# 3. ルーティング（役割ごとにどのプロバイダを使うか）
#    auto = 下記の優先順で「使えるもの」を自動選択
#      reasoning   : anthropic -> claude_cli -> openai -> gemini -> groq
#      longcontext : gemini -> anthropic -> claude_cli -> openai
#      fast        : groq -> gemini -> claude_cli -> anthropic -> openai
#      light       : groq -> gemini -> openai -> claude_cli -> anthropic
#    固定したいときは provider 名を直接書く
#      （anthropic / claude_cli / openai / gemini / groq）
# ------------------------------------------------------------
AP_ROUTE_REASONING=auto
AP_ROUTE_LONGCONTEXT=auto
AP_ROUTE_FAST=auto
AP_ROUTE_LIGHT=auto

# ------------------------------------------------------------
# 4. 生成バックエンド（auto / 明示 / stub）
#    stub にすると外部APIを一切叩かずダミー成果物だけ作る（配線確認用）
# ------------------------------------------------------------
AP_IMAGE_BACKEND=auto      # auto | openai | gemini | stability | stub
AP_TTS_BACKEND=auto        # auto | openai | elevenlabs | gtts | silent
AP_VIDEO_BACKEND=auto      # auto | moviepy | script（ffmpegコマンドの.shだけ出力）

# ------------------------------------------------------------
# 5. 動作設定
# ------------------------------------------------------------
AP_OUTPUT_DIR=output       # 成果物の出力先（ジョブごとにサブフォルダ）
AP_DEFAULT_SLIDES=8        # 既定のスライド枚数
AP_VIDEO_WIDTH=1920
AP_VIDEO_HEIGHT=1080
AP_VIDEO_FPS=24
AP_TTS_LANG=ja
AP_AUDIO_VOLUME=1.0        # 動画に載せるナレーションの音量倍率（1.0=原音・画面のスライダーが優先）
AP_STRICT_LEGAL=0          # 1 = 法務が critical を出した時点でパイプラインを止める
AP_LLM_TIMEOUT=180         # 1リクエストのタイムアウト秒
AP_IMAGE_TIMEOUT=300       # 画像1枚のタイムアウト秒
AP_CLAUDE_BIN=             # `claude` CLI のパス（空なら PATH から自動検出）

# ------------------------------------------------------------
# 6. 各部隊が使う道具（Claude Code単体と同じことをできるようにするため）
#    claude CLI 経由のときだけ有効。Bash/Write/Edit は既定で渡さない
#    （部隊が勝手にコマンドを実行したりPCのファイルを書き換えるのを防ぐため）
# ------------------------------------------------------------
AP_AGENT_TOOLS=on          # on | off（offにすると全部隊が「知識だけ」で考える。速いが裏が取れない）
AP_ALLOW_WEB=1             # 0 にするとWeb取得・検索をしない
AP_CLAUDE_WEB_TOOLS=WebFetch,WebSearch
AP_CLAUDE_FILE_TOOLS=Read,Glob,Grep
AP_WEB_TIMEOUT=600         # 道具を使う呼び出しのタイムアウト秒（ページ取得や検索が入るため長め）

# ------------------------------------------------------------
# 7. 課金の可否（このアプリは「全部無料の範囲」で動かす方針）
#    AP_ALLOW_PAID=0 の間は、有料の機能を一切呼ばない:
#      - AI画像生成（Gemini画像 / DALL-E 3 / Stability）… 無料枠なし
#      - Veo（画像→動画）… 無料枠なし・秒課金
#    代わりに使うもの（すべて無料）:
#      - 実写真のアップロード
#      - HTML+CSS → Playwright で作図（文字が崩れない）
#      - ケンバーンズ（ffmpegのズーム/パン）で静止画に動きを付ける
#      - Gemini のテキストモデル（無料枠あり）と claude CLI
# ------------------------------------------------------------
AP_ALLOW_PAID=0
AP_VIDEO_MOTION=kenburns   # kenburns | off

# フリー写真（Pexels・無料／登録のみ・支払い不要）
# https://www.pexels.com/api/ で取得。無くても Openverse で写真は入りますが、
# こちらを入れると写真の質が上がります。
PEXELS_API_KEY=
