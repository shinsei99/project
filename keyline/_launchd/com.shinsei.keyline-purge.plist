<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shinsei.keyline-purge</string>

    <!-- 身分証・名刺の画像を、返却から30日で自動削除する。毎日 3:30 に実行。
         KeepAlive は付けない（常駐ではなく1日1回の掃除）。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/apple/keyline/purge.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/apple/keyline</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/apple/keyline/logs/purge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/apple/keyline/logs/purge.log</string>
</dict>
</plist>
